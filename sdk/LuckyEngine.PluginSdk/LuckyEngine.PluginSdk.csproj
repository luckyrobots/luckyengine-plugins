<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>LuckyEngine.PluginSdk</PackageId>
    <Version>0.1.0</Version>
    <Description>Public, source-independent Lucky Engine native-panel plugin protocol and C# SDK.</Description>
    <Authors>Lucky Robots</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup><None Include="../README.md" Pack="true" PackagePath="/README.md" /></ItemGroup>
</Project>
